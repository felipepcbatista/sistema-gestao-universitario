@startuml Sistema de Matriculas - Diagrama de Caso de Uso

left to right direction
skinparam packageStyle rectangle

actor Aluno
actor Professor
actor Secretaria

rectangle "Sistema de Matrículas" {
  usecase "Autenticar-se" as UC1
  usecase "Matricular-se em Disciplina" as UC2
  usecase "Cancelar Matrícula" as UC3
  usecase "Consultar Alunos Matriculados" as UC4
  usecase "Cadastrar Curso" as UC5
  usecase "Cadastrar Disciplina" as UC6
  usecase "Gerar Currículo do Semestre" as UC7
}

Aluno --> UC2
Aluno --> UC3
Professor --> UC4
Secretaria --> UC5
Secretaria --> UC6
Secretaria --> UC7

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
UC7 ..> UC1 : <<include>>

@enduml
